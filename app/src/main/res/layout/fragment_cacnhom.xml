<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/CacNhomview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".fragmentSub.NhomView">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnbacklvview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/angle_small_left"
            app:tint="#000000"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/txtLVTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:text="Chi tiết luận văn"
            android:textColor="#BD8321"
            android:textSize="35dp"
            android:textStyle="bold|italic" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageLVview"
                android:layout_width="200dp"
                android:layout_height="250dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:scaleType="fitXY"
                tools:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center">


                    <Button
                        android:id="@+id/xemsau"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:backgroundTint="#4382E1"
                        android:drawableTint="#ffffff"
                        android:text="Thêm vào xem sau"
                        android:textColor="#FFFFFF"
                        app:icon="@drawable/bookmark_flase" />

                    <Button
                        android:id="@+id/btnsaveLVview"
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:layout_marginBottom="5dp"
                        android:backgroundTint="#884D36"
                        android:drawableLeft="@android:drawable/stat_sys_download"
                        android:text="Tải xuống"
                        android:textColor="#FFFFFF"
                        android:textSize="16dp"
                        app:icon="@drawable/download" />

                    <Button
                        android:id="@+id/btnSuaLVview"
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:layout_marginBottom="5dp"
                        android:backgroundTint="#884D36"
                        android:drawableLeft="@android:drawable/ic_menu_edit"
                        android:drawablePadding="0dp"
                        android:text="Chỉnh sửa"
                        android:textColor="#FFFFFF"
                        android:textSize="16dp"
                        app:icon="@drawable/pencil" />

                    <Button
                        android:id="@+id/btnDeleteLVview"
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:layout_marginBottom="5dp"
                        android:backgroundTint="#FF1212"
                        android:drawableStart="@android:drawable/ic_menu_delete"
                        android:drawablePadding="4dp"
                        android:drawableTint="#FFFFFF"
                        android:text="Xóa Luận văn"
                        android:textColor="#FFFFFF"
                        android:textSize="16dp"
                        app:icon="@drawable/trash" />
                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp">

                <TextView
                    android:id="@+id/textTenLVview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="Tiêu Đề"
                    android:textAlignment="center"
                    android:textColor="#BD8321"
                    android:textSize="40dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textngayupLVview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="dd/mm/yyyy"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView20"
                        android:layout_width="170dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tác giả : "
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/texttacgiaLVview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="20dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lĩnh vực :"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/textitemTypeLVview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="20dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày xuát bản : "
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/textngayxbLVview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="20dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/textView22"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mô Tả :"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/textmotaLVview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLength="1200"
                        android:textSize="20dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView24"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trích dẫn :"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/texttrichdanLVview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="1000"
                        android:textSize="20dp" />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>