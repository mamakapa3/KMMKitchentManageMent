<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/congcuMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff"
    tools:context=".fragmenthome.frag_CongCu">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swiperLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="Khác"
                    android:textColor="#422518"
                    android:textSize="50dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/viewTScc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="30dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/txtcc3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="Thống kê"
                        android:textColor="#000000"
                        android:textSize="20dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="40dp"
                            android:layout_weight="1"
                            android:text="Tổng số luận văn:"
                            android:textColor="#000000"
                            android:textSize="17dp" />

                        <TextView
                            android:id="@+id/all"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="17dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView15"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="40dp"
                            android:layout_weight="1"
                            android:text="Luận văn mới trong 7 ngày: "
                            android:textColor="#000000"
                            android:textSize="17dp" />

                        <TextView
                            android:id="@+id/recent7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="17dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="40dp"
                            android:layout_weight="1"
                            android:text="Luận văn mới trong 30 ngày: "
                            android:textColor="#000000"
                            android:textSize="17dp" />

                        <TextView
                            android:id="@+id/recent30"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="17dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtcc5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="40dp"
                            android:layout_weight="1"
                            android:text="Luận văn đang phát triển: "
                            android:textColor="#000000"
                            android:textSize="17dp" />

                        <TextView
                            android:id="@+id/onprogress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="17dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtcc6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="40dp"
                            android:layout_weight="1"
                            android:text="Luận văn đã xuất bản: "
                            android:textColor="#000000"
                            android:textSize="17dp" />

                        <TextView
                            android:id="@+id/published"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="17dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtcc7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_weight="1"
                            android:text="Số lượng tác giả: "
                            android:textColor="#000000"
                            android:textSize="20dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCCTongTG"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="20dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtcc9"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_weight="1"
                            android:text="Số lượng lĩnh vực: "
                            android:textColor="#000000"
                            android:textSize="20dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCCTongCD"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="#132FCC"
                            android:textSize="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="30dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="20dp"
                    android:paddingRight="20dp">

                    <Button
                        android:id="@+id/historyBtn"
                        android:layout_width="250dp"
                        android:layout_height="match_parent"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#00FFFFFF"
                        android:includeFontPadding="false"
                        android:padding="20dp"
                        android:shadowColor="#3B494848"
                        android:shadowDx="5"
                        android:shadowDy="3"
                        android:shadowRadius="2"
                        android:text="Lịch sử"
                        android:textColor="#563324"
                        android:textSize="18dp"
                        app:cornerRadius="15dp"
                        app:icon="@drawable/history"
                        app:iconPadding="0dp"
                        app:iconSize="25dp"
                        app:iconTint="#49291D"
                        app:strokeColor="#563324"
                        app:strokeWidth="3dp" />

                    <Button
                        android:id="@+id/savetofileBtn"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#00FFFFFF"
                        android:includeFontPadding="false"
                        android:padding="20dp"
                        android:shadowColor="#3B494848"
                        android:shadowDx="5"
                        android:shadowDy="3"
                        android:shadowRadius="2"
                        android:text="Lưu vào file"
                        android:textColor="#563324"
                        android:textSize="18dp"
                        app:cornerRadius="15dp"
                        app:icon="@drawable/folder_download"
                        app:iconPadding="0dp"
                        app:iconSize="25dp"
                        app:iconTint="#49291D"
                        app:strokeColor="#563324"
                        app:strokeWidth="3dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="20dp"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp">

                    <Button
                        android:id="@+id/inforView"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#00FFFFFF"
                        android:includeFontPadding="false"
                        android:padding="20dp"
                        android:shadowColor="#3B494848"
                        android:shadowDx="5"
                        android:shadowDy="3"
                        android:shadowRadius="2"
                        android:text="Thông tin"
                        android:textColor="#563324"
                        android:textSize="18dp"
                        app:cornerRadius="15dp"
                        app:icon="@drawable/info"
                        app:iconPadding="0dp"
                        app:iconSize="25dp"
                        app:iconTint="#49291D"
                        app:strokeColor="#563324"
                        app:strokeWidth="3dp" />

                    <Button
                        android:id="@+id/btnExit"
                        android:layout_width="250dp"
                        android:layout_height="match_parent"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#00FFFFFF"
                        android:includeFontPadding="false"
                        android:padding="20dp"
                        android:shadowColor="#3B494848"
                        android:shadowDx="5"
                        android:shadowDy="3"
                        android:shadowRadius="2"
                        android:text="Thoát"
                        android:textColor="#FF0000"
                        android:textSize="18dp"
                        app:cornerRadius="15dp"
                        app:icon="@drawable/exit"
                        app:iconPadding="0dp"
                        app:iconSize="25dp"
                        app:iconTint="#FF3333"
                        app:strokeColor="#FF0000"
                        app:strokeWidth="3dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


</androidx.constraintlayout.widget.ConstraintLayout>