<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragmenthome.ThongBao"
    android:background="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="16dp">

        <TextView
            android:id="@+id/textView18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="THÔNG BÁO"
            android:textSize="37sp"
            android:textStyle="bold"
            android:paddingHorizontal="25dp"/>

        <TextView
            android:id="@+id/nofiLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bạn có n thông báo mới!"
            android:textColor="@android:color/holo_red_light"
            android:layout_marginLeft="40dp"
            android:textSize="17sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <Button
            android:id="@+id/button2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="15dp">
        </View>

        <Spinner
            android:id="@+id/mySpinner"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="25dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/spinner_background"
            android:popupBackground="#FFFFFF"
            tools:ignore="TouchTargetSizeCheck" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textReadNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="&lt;Đánh dấu đã đọc&gt;"
                android:textColor="#3F51B5"
                android:textSize="17sp"
                tools:ignore="TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
            </View>

            <TextView
                android:id="@+id/textDeleteNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="&lt;Xóa tất cả&gt;"
                android:textColor="#3F51B5"
                android:gravity="end"
                android:textSize="17sp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="20dp"
            android:background="#212121">

        </View>

        <ListView
            android:id="@+id/lvNotification"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </LinearLayout>

    <!-- res/layout/activity_main.xml -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>