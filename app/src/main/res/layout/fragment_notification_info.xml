<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".thongbao.NotificationInfo"
    android:background="#FFFFFF">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="15dp">

        <TextView
            android:id="@+id/fragment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_vertical"
            android:text="Chi Tiết Tin Nhắn"
            android:textColor="#333333"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Báo cáo" />
    </LinearLayout>

    <TextView
        android:id="@+id/logReported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tin nhắn này đang trong quá trình xử lý..."
        android:textColor="@android:color/holo_red_light"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:visibility="visible"/>

    <!-- Tiêu đề tin nhắn -->
    <TextView
        android:id="@+id/message_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiêu đề tin nhắn"
        android:textSize="25sp"
        android:layout_marginLeft="40dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_below="@id/fragment_title"/>

    <!-- Người gửi -->
    <TextView
        android:id="@+id/message_sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:text="Người gửi: User"
        android:textSize="17sp"
        android:textColor="#555555"
        android:textStyle="italic"
        android:layout_below="@id/message_title"
        android:layout_marginBottom="3dp"/>

    <!-- Ngày -->
    <TextView
        android:id="@+id/message_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thời gian: 01/01/2024"
        android:layout_marginLeft="60dp"
        android:textSize="16sp"
        android:textColor="#555555"
        android:textStyle="italic"
        android:layout_below="@id/message_sender"
        android:layout_marginBottom="8dp"/>

    <!-- Nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp">

        <TextView
            android:id="@+id/message_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="15dp"
            android:text="Nội dung tin nhắn"
            android:textSize="16sp"
            android:textColor="#000000"
            android:padding="8dp"/>
    </ScrollView>



</LinearLayout>