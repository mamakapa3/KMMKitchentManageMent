<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/KhoItemView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".fragmentSub.NhomView">

    <!-- Header: Nút back + Tiêu đề -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnbacklvviewi"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/angle_small_left"
            app:tint="#000000"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/txtLVTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="Chi tiết Items"
            android:textColor="#BD8321"
            android:textSize="30sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <!-- Nội dung chính -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/imageLVviewi"
                android:layout_width="200dp"
                android:layout_height="250dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:scaleType="fitXY"
                tools:src="@tools:sample/avatars" />

            <!-- Tiêu đề sản phẩm -->
            <TextView
                android:id="@+id/textTenLVviewi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:text="Tiêu Đề"
                android:textAlignment="center"
                android:textColor="#BD8321"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Các thông tin chi tiết -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textNumberLVviewi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Số lượng: "
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textitemTypeLVviewi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loại: "
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textngayupLVviewi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ngày Nhập: "
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textmotaLVviewi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mô tả: "
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/texttrichdanLVviewi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nguồn: "
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Nút Tăng/Giảm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTangview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D8B533"
                    android:text="Tăng"
                    android:textSize="20sp"
                    app:icon="@drawable/arrow_up"
                    app:iconSize="20dp" />

                <Button
                    android:id="@+id/btnGiamview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FD0000"
                    android:text="Giảm"
                    android:textSize="20sp"
                    app:icon="@drawable/arrow_down"
                    app:iconSize="20dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
